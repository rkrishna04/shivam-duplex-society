generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model Society { id String @id @default(uuid()) @db.Uuid name String @db.VarChar(160) timezone String @default("Asia/Kolkata") @db.VarChar(64) latitude Decimal? @db.Decimal(9,6) longitude Decimal? @db.Decimal(9,6) createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6) updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6) houses House[] @@map("societies") }
model User { id String @id @default(uuid()) @db.Uuid fullName String @map("full_name") @db.VarChar(120) phoneE164 String @unique @map("phone_e164") @db.VarChar(16) email String? @unique @db.VarChar(254) passwordHash String? @map("password_hash") profilePhotoKey String? @map("profile_photo_key") isActive Boolean @default(true) @map("is_active") phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(6) createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6) updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6) memberships HouseMembership[] @@map("users") }
model House { id BigInt @id @default(autoincrement()) houseNumber String @map("house_number") @db.VarChar(20) societyId String @map("society_id") @db.Uuid occupancy String @default("VACANT") @db.VarChar(20) mapNodeId String @map("map_node_id") @db.VarChar(80) mapX Decimal? @map("map_x") @db.Decimal(8,3) mapY Decimal? @map("map_y") @db.Decimal(8,3) mapZ Decimal? @map("map_z") createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6) updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6) society Society @relation(fields:[societyId],references:[id]) memberships HouseMembership[] @@unique([societyId,houseNumber]) @@unique([societyId,mapNodeId]) @@map("houses") }
model HouseMembership { id BigInt @id @default(autoincrement()) houseId BigInt @map("house_id") userId String @map("user_id") @db.Uuid role String @db.VarChar(20) isPrimary Boolean @default(false) @map("is_primary") validFrom DateTime @default(now()) @map("valid_from") @db.Date validUntil DateTime? @map("valid_until") @db.Date createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6) house House @relation(fields:[houseId],references:[id],onDelete:Cascade) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@unique([houseId,userId,role,validFrom]) @@index([userId,role,houseId]) @@map("house_memberships") }
