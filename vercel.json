{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Content-Type", "value": "application/javascript" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" },
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/index", "destination": "/index.html" },
    { "source": "/members", "destination": "/members.html" },
    { "source": "/maintenance", "destination": "/maintenance.html" },
    { "source": "/payments", "destination": "/payments.html" },
    { "source": "/expenses", "destination": "/expenses.html" },
    { "source": "/funds", "destination": "/funds.html" },
    { "source": "/events", "destination": "/events.html" },
    { "source": "/notices", "destination": "/notices.html" },
    { "source": "/reports", "destination": "/reports.html" },
    { "source": "/resident", "destination": "/resident.html" }
  ]
}
